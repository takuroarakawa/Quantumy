# ============================================================
# Vercel 本番環境変数（Vercel Dashboard > Settings > Environment Variables に登録）
# ============================================================

# --- Database (Vercel Postgres / Supabase) ---
DB_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@host:5432/db"

# --- NextAuth ---
NEXTAUTH_SECRET=""         # openssl rand -base64 32
NEXTAUTH_URL="https://YOUR_APP.vercel.app"

# --- Quantumy 連携 ---
NEXT_PUBLIC_QUANTUMY_URL="https://quantumy.vercel.app"
NEXT_PUBLIC_QUANTUMY_API_URL="https://api.quantumy.vercel.app"
NEXT_PUBLIC_ELEMENTARY_URL="https://YOUR_APP.vercel.app"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="elementary-videos"
R2_PUBLIC_URL=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
